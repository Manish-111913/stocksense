  productsProductsUpdatedByTousers                         Product[]             @relation("products_updated_byTousers")
  receiptsReceiptsCreatedByTousers                         Receipt[]             @relation("receipts_created_byTousers")
  receiptsReceiptsUpdatedByTousers                         Receipt[]             @relation("receipts_updated_byTousers")
  receiptsReceiptsValidatedByTousers                       Receipt[]             @relation("receipts_validated_byTousers")
  stockLedgers                                             StockLedger[]
  warehousesWarehousesCreatedByTousers                     Warehouse[]           @relation("warehouses_created_byTousers")
  warehousesWarehousesUpdatedByTousers                     Warehouse[]           @relation("warehouses_updated_byTousers")

  @@map("users")
}

model Warehouse {
  id                                                                   String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name                                                                 String                @db.VarChar(150)
  code                                                                 String                @unique @db.VarChar(50)
  description                                                          String?
  status                                                               RecordStatus          @default(ACTIVE)
  createdAt                                                            DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                                                            DateTime              @default(now()) @map("updated_at") @db.Timestamptz(6)
  createdBy                                                            String                @map("created_by") @db.Uuid
  updatedBy                                                            String?               @map("updated_by") @db.Uuid
  deliveries                                                           Delivery[]
  internalTransfersInternalTransfersDestinationWarehouseIdTowarehouses InternalTransfer[]    @relation("internal_transfers_destination_warehouse_idTowarehouses")
  internalTransfersInternalTransfersSourceWarehouseIdTowarehouses      InternalTransfer[]    @relation("internal_transfers_source_warehouse_idTowarehouses")
  inventoryAdjustments                                                 InventoryAdjustment[]
  locations                                                            Location[]
  receipts                                                             Receipt[]
  stockLedgers                                                         StockLedger[]
  createdByUser                                                        User                  @relation("warehouses_created_byTousers", fields: [createdBy], references: [id], onUpdate: NoAction)
  updatedByUser                                                        User?                 @relation("warehouses_updated_byTousers", fields: [updatedBy], references: [id], onDelete: Restrict, onUpdate: NoAction)

  @@index([status])
  @@map("warehouses")
}

enum DocumentStatus {
  DRAFT
  WAITING
  READY
  DONE
  CANCELED

  @@map("document_status")
}

enum InventoryOperation {
  RECEIPT
  DELIVERY
  INTERNAL_TRANSFER
  ADJUSTMENT

  @@map("inventory_operation")
}

enum LedgerDirection {
  IN
  OUT
  TRANSFER
  ADJUSTMENT_IN
  ADJUSTMENT_OUT

  @@map("ledger_direction")
}

enum RecordStatus {
  ACTIVE
  INACTIVE

  @@map("record_status")
}

enum UserRole {
  INVENTORY_MANAGER
  WAREHOUSE_STAFF

  @@map("user_role")
}
