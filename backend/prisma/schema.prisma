generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

model Category {
  id          String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String       @unique @db.VarChar(100)
  description String?
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime     @default(now()) @map("updated_at") @db.Timestamptz(6)
  status      RecordStatus @default(ACTIVE)
  products    Product[]

  @@index([status])
  @@map("categories")
}

model Customer {
  id         String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name       String       @db.VarChar(200)
  code       String?      @unique @db.VarChar(50)
  email      String?      @db.VarChar(255)
  phone      String?      @db.VarChar(30)
  status     RecordStatus @default(ACTIVE)
  createdAt  DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime     @default(now()) @map("updated_at") @db.Timestamptz(6)
  deliveries Delivery[]

  @@index([name])
  @@map("customers")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model Delivery {
  id                                String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  reference                         String         @unique @default(dbgenerated("('WH/OUT/'::text || lpad((nextval('delivery_reference_seq'::regclass))::text, 6, '0'::text))")) @db.VarChar(50)
  customerId                        String         @map("customer_id") @db.Uuid
  warehouseId                       String         @map("warehouse_id") @db.Uuid
  sourceLocationId                  String         @map("source_location_id") @db.Uuid
  status                            DocumentStatus @default(DRAFT)
  deliveryDate                      DateTime       @default(now()) @map("delivery_date") @db.Timestamptz(6)
  createdBy                         String         @map("created_by") @db.Uuid
  updatedBy                         String?        @map("updated_by") @db.Uuid
  pickedBy                          String?        @map("picked_by") @db.Uuid
  pickedAt                          DateTime?      @map("picked_at") @db.Timestamptz(6)
  packedBy                          String?        @map("packed_by") @db.Uuid
  packedAt                          DateTime?      @map("packed_at") @db.Timestamptz(6)
  validatedBy                       String?        @map("validated_by") @db.Uuid
  validatedAt                       DateTime?      @map("validated_at") @db.Timestamptz(6)
  createdAt                         DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                         DateTime       @default(now()) @map("updated_at") @db.Timestamptz(6)
  usersDeliveriesCreatedByTousers   User           @relation("deliveries_created_byTousers", fields: [createdBy], references: [id], onUpdate: NoAction)
  customers                         Customer       @relation(fields: [customerId], references: [id], onUpdate: NoAction)
  locations                         Location       @relation(fields: [sourceLocationId, warehouseId], references: [id, warehouseId], onUpdate: NoAction, map: "deliveries_location_in_warehouse_fk")
  usersDeliveriesPackedByTousers    User?          @relation("deliveries_packed_byTousers", fields: [packedBy], references: [id], onDelete: Restrict, onUpdate: NoAction)
  usersDeliveriesPickedByTousers    User?          @relation("deliveries_picked_byTousers", fields: [pickedBy], references: [id], onDelete: Restrict, onUpdate: NoAction)
  usersDeliveriesUpdatedByTousers   User?          @relation("deliveries_updated_byTousers", fields: [updatedBy], references: [id], onDelete: Restrict, onUpdate: NoAction)
  usersDeliveriesValidatedByTousers User?          @relation("deliveries_validated_byTousers", fields: [validatedBy], references: [id], onDelete: Restrict, onUpdate: NoAction)
  warehouses                        Warehouse      @relation(fields: [warehouseId], references: [id], onUpdate: NoAction)
  deliveryItems                     DeliveryItem[]

  @@index([customerId])
  @@index([deliveryDate])
  @@index([sourceLocationId])
  @@index([status])
  @@index([warehouseId])
  @@map("deliveries")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model DeliveryItem {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  deliveryId String   @map("delivery_id") @db.Uuid
  productId  String   @map("product_id") @db.Uuid
  quantity   Decimal  @db.Decimal(18, 3)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)
  deliveries Delivery @relation(fields: [deliveryId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  products   Product  @relation(fields: [productId], references: [id], onUpdate: NoAction)

  @@unique([deliveryId, productId], map: "delivery_items_delivery_product_key")
  @@index([productId])
  @@map("delivery_items")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model InternalTransferItem {
  id                String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  transferId        String           @map("transfer_id") @db.Uuid
  productId         String           @map("product_id") @db.Uuid
  quantity          Decimal          @db.Decimal(18, 3)
  createdAt         DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime         @default(now()) @map("updated_at") @db.Timestamptz(6)
  products          Product          @relation(fields: [productId], references: [id], onUpdate: NoAction)
  internalTransfers InternalTransfer @relation(fields: [transferId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([transferId, productId], map: "internal_transfer_items_transfer_product_key")
  @@index([productId])
  @@map("internal_transfer_items")
}

