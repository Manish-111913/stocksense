  id                                                                                       String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  warehouseId                                                                              String                @map("warehouse_id") @db.Uuid
  name                                                                                     String                @db.VarChar(150)
  code                                                                                     String                @db.VarChar(50)
  status                                                                                   RecordStatus          @default(ACTIVE)
  createdAt                                                                                DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                                                                                DateTime              @default(now()) @map("updated_at") @db.Timestamptz(6)
  deliveries                                                                               Delivery[]
  internalTransfersInternalTransfersDestinationLocationIdDestinationWarehouseIdTolocations InternalTransfer[]    @relation("internal_transfers_destination_location_id_destination_warehouse_idTolocations")
  internalTransfersInternalTransfersSourceLocationIdSourceWarehouseIdTolocations           InternalTransfer[]    @relation("internal_transfers_source_location_id_source_warehouse_idTolocations")
  inventoryAdjustments                                                                     InventoryAdjustment[]
  warehouse                                                                                Warehouse             @relation(fields: [warehouseId], references: [id], onUpdate: NoAction)
  receipts                                                                                 Receipt[]
  stocks                                                                                   Stock[]
  stockLedgerStockLedgerDestinationLocationIdTolocations                                   StockLedger[]         @relation("stock_ledger_destination_location_idTolocations")
  stockLedgerStockLedgerLocationIdWarehouseIdTolocations                                   StockLedger[]         @relation("stock_ledger_location_id_warehouse_idTolocations")
  stockLedgerStockLedgerSourceLocationIdTolocations                                        StockLedger[]         @relation("stock_ledger_source_location_idTolocations")

  @@unique([id, warehouseId], map: "locations_id_warehouse_key")
  @@unique([warehouseId, code], map: "locations_warehouse_code_key")
  @@index([status])
  @@index([warehouseId])
  @@map("locations")
}

