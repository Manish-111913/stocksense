  locationsInternalTransfersDestinationLocationIdDestinationWarehouseIdTolocations Location               @relation("internal_transfers_destination_location_id_destination_warehouse_idTolocations", fields: [destinationLocationId, destinationWarehouseId], references: [id, warehouseId], onUpdate: NoAction, map: "internal_transfers_destination_in_warehouse_fk")
  warehousesInternalTransfersDestinationWarehouseIdTowarehouses                    Warehouse              @relation("internal_transfers_destination_warehouse_idTowarehouses", fields: [destinationWarehouseId], references: [id], onUpdate: NoAction)
  locationsInternalTransfersSourceLocationIdSourceWarehouseIdTolocations           Location               @relation("internal_transfers_source_location_id_source_warehouse_idTolocations", fields: [sourceLocationId, sourceWarehouseId], references: [id, warehouseId], onUpdate: NoAction, map: "internal_transfers_source_in_warehouse_fk")
  warehousesInternalTransfersSourceWarehouseIdTowarehouses                         Warehouse              @relation("internal_transfers_source_warehouse_idTowarehouses", fields: [sourceWarehouseId], references: [id], onUpdate: NoAction)
  usersInternalTransfersUpdatedByTousers                                           User?                  @relation("internal_transfers_updated_byTousers", fields: [updatedBy], references: [id], onDelete: Restrict, onUpdate: NoAction)
  usersInternalTransfersValidatedByTousers                                         User?                  @relation("internal_transfers_validated_byTousers", fields: [validatedBy], references: [id], onDelete: Restrict, onUpdate: NoAction)

  @@index([destinationLocationId])
  @@index([sourceLocationId])
