NODE_ENV=development
PORT=4100
CORS_ORIGIN=http://localhost:5173

DATABASE_URL=postgresql://stocksense:change-me@localhost:5432/stocksense

JWT_ACCESS_SECRET=change-me-to-a-long-random-string
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change-me-to-a-long-random-string
JWT_REFRESH_EXPIRES_IN=7d
JWT_RESET_SECRET=change-me-to-a-long-random-string
JWT_RESET_EXPIRES_IN=10m

OTP_EXPIRY_MINUTES=5
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=30

# Email (password-reset OTPs). Leave SMTP_HOST empty in development to print OTPs to the server log instead.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="StockSense <no-reply@stocksense.local>"
