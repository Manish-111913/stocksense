/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model InventoryAdjustment {
  id                                        String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  reference                                 String         @unique @default(dbgenerated("('WH/ADJ/'::text || lpad((nextval('adjustment_reference_seq'::regclass))::text, 6, '0'::text))")) @db.VarChar(50)
  productId                                 String         @map("product_id") @db.Uuid
  warehouseId                               String         @map("warehouse_id") @db.Uuid
  locationId                                String         @map("location_id") @db.Uuid
  recordedQuantity                          Decimal        @map("recorded_quantity") @db.Decimal(18, 3)
  recordedStockVersion                      Int            @default(0) @map("recorded_stock_version")
  physicalQuantity                          Decimal        @map("physical_quantity") @db.Decimal(18, 3)
  difference                                Decimal        @db.Decimal(18, 3)
  reason                                    String         @db.VarChar(255)
  notes                                     String?
  status                                    DocumentStatus @default(DRAFT)
  createdBy                                 String         @map("created_by") @db.Uuid
  updatedBy                                 String?        @map("updated_by") @db.Uuid
  appliedBy                                 String?        @map("applied_by") @db.Uuid
  appliedAt                                 DateTime?      @map("applied_at") @db.Timestamptz(6)
  createdAt                                 DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                                 DateTime       @default(now()) @map("updated_at") @db.Timestamptz(6)
  usersInventoryAdjustmentsAppliedByTousers User?          @relation("inventory_adjustments_applied_byTousers", fields: [appliedBy], references: [id], onDelete: Restrict, onUpdate: NoAction)
  usersInventoryAdjustmentsCreatedByTousers User           @relation("inventory_adjustments_created_byTousers", fields: [createdBy], references: [id], onUpdate: NoAction)
  locations                                 Location       @relation(fields: [locationId, warehouseId], references: [id, warehouseId], onUpdate: NoAction, map: "inventory_adjustments_location_in_warehouse_fk")
  products                                  Product        @relation(fields: [productId], references: [id], onUpdate: NoAction)
  usersInventoryAdjustmentsUpdatedByTousers User?          @relation("inventory_adjustments_updated_byTousers", fields: [updatedBy], references: [id], onDelete: Restrict, onUpdate: NoAction)
  warehouses                                Warehouse      @relation(fields: [warehouseId], references: [id], onUpdate: NoAction)

  @@index([createdAt])
  @@index([locationId])
  @@index([productId])
  @@index([status])
  @@map("inventory_adjustments")
}

